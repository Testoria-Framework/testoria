{
  "name": "testoria",
  "version": "2.0.0",
  "description": "Testoria JavaScript API test suites",
  "main": "core/clients/base_api_client.js",
  "scripts": {
    "test": "mocha 'tests/{functional,integration,security}_tests/javascript/test_*.js'",
    "test:functional": "mocha 'tests/functional_tests/javascript/test_*.js'",
    "test:integration": "mocha 'tests/integration_tests/javascript/test_*.js'",
    "test:security": "mocha 'tests/security_tests/javascript/test_*.js'",
    "test:all": "bash scripts/run_tests.sh --language all --type all"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Testoria-Framework/testoria.git"
  },
  "keywords": [
    "api",
    "testing",
    "automation",
    "rest",
    "framework",
    "qa"
  ],
  "author": "Mohamed Amine Ben Salah",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/Testoria-Framework/testoria/issues"
  },
  "homepage": "https://github.com/Testoria-Framework/testoria#readme",
  "dependencies": {
    "axios": "^1.3.4",
    "axios-retry": "^3.4.0",
    "chai": "^4.3.7",
    "chai-json-schema": "^1.5.1",
    "dotenv": "^16.0.3",
    "jsonwebtoken": "^9.0.0",
    "lodash": "^4.17.21",
    "mocha": "^10.2.0",
    "mochawesome": "^7.1.3"
  },
  "devDependencies": {
    "ajv": "^8.12.0"
  },
  "engines": {
    "node": ">=18"
  }
}
