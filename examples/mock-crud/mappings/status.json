{
  "mappings": [
    {
      "request": {"method": "GET", "url": "/status"},
      "response": {"status": 200, "jsonBody": {"status": "up", "served_at": "{{now}}"}}
    },
    {
      "request": {"method": "GET", "urlPathPattern": "/echo/.+"},
      "response": {"status": 200, "jsonBody": {"segment": "{{request.pathSegments.[1]}}", "q": "{{request.query.q}}"}}
    },
    {
      "request": {"method": "GET", "url": "/slow"},
      "response": {"status": 200, "fixedDelayMilliseconds": 300, "body": "ok"}
    }
  ]
}
